---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PostCollection from "../../components/PostCollection.astro";
import { SITE_AUTHOR, SITE_DESCRIPTION } from "../../consts";
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const years = [
  ...new Set(posts.map((post) => post.data.pubDate.getUTCFullYear())),
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`blog · ${SITE_AUTHOR}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main id="main-content" class="ds-container ds-archive">
      <header class="ds-archive-heading">
        <h1>文章</h1>
        <p>{SITE_DESCRIPTION}</p>
      </header>
      {years.map((year) => (
        <section class="ds-archive-year" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`}>{year}</h2>
          <div class="ds-year-posts">
            <PostCollection
              posts={posts.filter(
                (post) => post.data.pubDate.getUTCFullYear() === year,
              )}
              compact
            />
          </div>
        </section>
      ))}
      {!posts.length && <p>还没有公开文章。</p>}
    </main>
    <Footer />
  </body>
</html>
<style>
  .ds-archive-heading,
  .ds-archive-year {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(
        0,
        var(--reading-width)
      ) minmax(0, 1fr);
    column-gap: 2.5rem;
  }
  .ds-archive-heading {
    padding: 3.5rem 0 3rem;
    row-gap: 1rem;
  }
  .ds-archive-heading h1,
  .ds-archive-heading p,
  .ds-year-posts {
    grid-column: 2 / -1;
  }
  .ds-archive-year {
    align-items: start;
    padding-bottom: 2rem;
  }
  .ds-archive-year h2 {
    margin: 0;
    padding-top: 1.3rem;
    font-size: 1.65rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  h1 {
    margin: 0;
    font-size: 3rem;
  }
  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  @media (max-width: 76rem) {
    .ds-archive-heading,
    .ds-archive-year {
      grid-template-columns: 8rem minmax(0, 1fr);
      column-gap: 2rem;
    }
  }
  @media (max-width: 44rem) {
    .ds-archive-heading,
    .ds-archive-year {
      display: block;
    }
    .ds-archive-heading {
      padding: 2rem 0;
    }
    .ds-archive-heading p {
      margin-top: 0.75rem;
    }
    .ds-archive-year h2 {
      padding: 0 0 1rem;
      font-size: 1.35rem;
    }
    h1 {
      font-size: 2rem;
    }
    p {
      font-size: 0.8rem;
    }
  }
</style>
