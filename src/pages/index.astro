---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PostCollection from "../components/PostCollection.astro";
import AuthorRail from "../components/AuthorRail.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main id="main-content" class="ds-container ds-home">
      <aside class="ds-home-intro" aria-label="作者与站点信息">
        <AuthorRail />
      </aside>
      <div class="ds-home-writing">
        <header class="ds-home-heading">
          <h1>文章</h1>
          <a href="/blog/">按时间浏览</a>
        </header>
        {posts.length ? (
          <PostCollection posts={posts} featured />
        ) : (
          <p>还没有公开文章。</p>
        )}
      </div>
    </main>
    <Footer />
  </body>
</html>
<style>
  .ds-home {
    display: grid;
    grid-template-columns: minmax(11rem, 1fr) minmax(0, 42rem) minmax(
        11rem,
        1fr
      );
    gap: 2.5rem;
    padding-top: 3.5rem;
    padding-bottom: 1rem;
  }
  .ds-home-intro {
    position: sticky;
    top: 3rem;
    padding-top: 0.3rem;
    align-self: start;
  }
  .ds-home-writing {
    grid-column: 2 / -1;
    min-width: 0;
  }
  .ds-home-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 0 0 1.5rem;
    gap: 1rem;
  }
  h1 {
    font-size: 1.5rem;
    margin: 0;
    font-weight: 500;
  }
  .ds-home-heading a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: var(--accent-dark);
    text-decoration: none;
    font-size: 0.8rem;
  }
  @media (max-width: 76rem) {
    .ds-home {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 2rem;
    }
  }
  @media (max-width: 44rem) {
    .ds-home {
      display: block;
      padding-top: 2rem;
    }
    .ds-home-intro {
      position: static;
      padding: 0 0 1.5rem;
    }
    .ds-home-heading {
      padding: 0.5rem 0 1rem;
    }
    h1 {
      font-size: 1.35rem;
      margin: 0;
    }
    .ds-home-heading a {
      font-size: 0.75rem;
    }
  }
</style>
