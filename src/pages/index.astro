---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PostCollection from "../components/PostCollection.astro";
import AuthorRail from "../components/AuthorRail.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main id="main-content" class="ds-container ds-home">
      <aside class="ds-home-intro" aria-label="作者与站点信息">
        <AuthorRail />
      </aside>
      <div class="ds-home-writing">
        <h1 class="sr-only">文章</h1>
        {posts.length ? (
          <PostCollection posts={posts} featured />
        ) : (
          <p>还没有公开文章。</p>
        )}
      </div>
    </main>
    <Footer />
  </body>
</html>
<style>
  .ds-home {
    display: grid;
    grid-template-columns: minmax(11rem, 1fr) minmax(0, 42rem) minmax(
        11rem,
        1fr
      );
    gap: 2.5rem;
    padding-top: var(--page-start-space);
    padding-bottom: 1rem;
  }
  .ds-home-intro {
    position: sticky;
    top: 3rem;
    padding-top: 0.25rem;
    align-self: start;
  }
  .ds-home-writing {
    grid-column: 2 / -1;
    min-width: 0;
  }
  @media (max-width: 76rem) {
    .ds-home {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 2rem;
    }
  }
  @media (max-width: 60rem) {
    .ds-home {
      display: block;
    }
    .ds-home-intro {
      position: static;
      padding: 0 0 2.5rem;
    }
  }
  @media (max-width: 44rem) {
    .ds-home-intro {
      padding-bottom: 2rem;
    }
  }
</style>
