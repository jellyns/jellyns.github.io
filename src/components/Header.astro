---
import { SITE_AUTHOR } from "../consts";
const isBlog = Astro.url.pathname.startsWith("/blog");
---

<!--
THESIS: 文章标题直接成为入口，首页形成有主次的文章目录。
OWN-WORLD: 保留近白纸面、宋体标题、墨色正文、朱红标记；使用开放版面。
STORY: 浏览最新文章与并排旧文，鼠标或键盘选择，标题衔接到全文。
FIRST VIEWPORT: 首页左侧简短介绍，右侧文章主次分明；博文页正文居中，左右分别承载本文信息与阅读导航。
FORM: 根据用户对重复 CTA、文章放置与页面级动效的纠正重排；旧 A 稿已被本次指示取代。
-->
<a class="skip-link" href="#main-content">
  跳到正文
</a>
<header class="ds-site-header ds-container">
  <nav aria-label="主导航">
    <a class="ds-brand" href="/" aria-label={SITE_AUTHOR + "，首页"}>
      {SITE_AUTHOR}
      <span>blog</span>
    </a>
    <div class="ds-nav-links">
      <a href="/blog/" aria-current={isBlog ? "page" : undefined}>
        文章
      </a>
      <a href="/rss.xml" data-astro-reload>
        RSS
      </a>
    </div>
  </nav>
</header>
<style>
  .ds-site-header {
    border-bottom: 1px solid var(--line);
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 104px;
    gap: 1rem;
  }
  .ds-brand {
    display: inline-block;
    min-height: 44px;
    align-content: center;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.85rem;
    text-decoration: none;
    white-space: nowrap;
    letter-spacing: -0.02em;
  }
  .ds-brand span {
    color: var(--muted);
    font-size: 1rem;
    font-weight: 500;
    margin-left: 1.1rem;
    letter-spacing: 0;
  }
  .ds-nav-links {
    display: flex;
    gap: 2rem;
  }
  .ds-nav-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--muted);
    font-size: 0.9rem;
    padding: 0.65rem 0;
    position: relative;
    text-decoration: none;
  }
  .ds-nav-links a::after {
    content: "";
    position: absolute;
    bottom: 0.25rem;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 240ms var(--ease);
  }
  .ds-nav-links a:hover,
  .ds-nav-links a:focus-visible,
  .ds-nav-links a[aria-current] {
    color: var(--accent);
  }
  .ds-nav-links a:hover::after,
  .ds-nav-links a:focus-visible::after,
  .ds-nav-links a[aria-current]::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  @media (max-width: 40rem) {
    nav {
      min-height: 80px;
    }
    .ds-brand {
      font-size: 1.35rem;
    }
    .ds-brand span {
      margin-left: 0.65rem;
      font-size: 0.8rem;
    }
    .ds-nav-links {
      gap: 0.65rem;
    }
    .ds-nav-links a {
      font-size: 0.8rem;
    }
  }
  @media (max-width: 23rem) {
    nav {
      gap: 0.5rem;
    }
    .ds-brand {
      font-size: 1.15rem;
    }
    .ds-brand span {
      margin-left: 0.4rem;
      font-size: 0.7rem;
    }
    .ds-nav-links {
      gap: 0;
    }
  }
</style>
