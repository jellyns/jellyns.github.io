---
import { SITE_AUTHOR, SITE_DESCRIPTION } from "../consts";
---

<div class="ds-author-rail">
  <a class="ds-author-name" href="/">
    {SITE_AUTHOR}
  </a>
  <p>{SITE_DESCRIPTION}</p>
  <nav aria-label="作者与站点">
    <a href="/blog/">文章目录</a>
    <a href="https://github.com/jellyns" target="_blank" rel="noreferrer">
      GitHub
    </a>
    <a href="/rss.xml" data-astro-reload>
      RSS 订阅
    </a>
  </nav>
</div>
<style>
  .ds-author-rail {
    max-width: 12rem;
    view-transition-name: site-author;
  }
  .ds-author-name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  p {
    margin: 0.75rem 0 1.75rem;
    font-size: 0.8125rem;
    line-height: 1.9;
    color: var(--muted);
  }
  nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    min-width: 44px;
    font-size: 0.8125rem;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.45em;
    color: var(--muted);
    transition:
      color 180ms var(--ease),
      text-decoration-color 180ms var(--ease);
  }
  a:hover,
  a:focus-visible {
    color: var(--accent-dark);
  }
  nav a:hover,
  nav a:focus-visible {
    text-decoration-color: currentColor;
  }
  @media (max-width: 44rem) {
    .ds-author-rail {
      max-width: none;
    }
    .ds-author-name {
      display: none;
    }
    p {
      margin: 0;
      max-width: none;
      font-size: 0.875rem;
    }
    nav {
      flex-direction: row;
      gap: 1.25rem;
      margin-top: 0.4rem;
      flex-wrap: wrap;
    }
    nav a {
      min-width: 0;
      gap: 0.4rem;
      font-size: 0.75rem;
    }
    nav a:first-child {
      display: none;
    }
  }
</style>
