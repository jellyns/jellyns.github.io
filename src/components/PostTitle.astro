---
import ChineseWords from "./ChineseWords.astro";
interface Props {
  title: string;
}
const { title } = Astro.props;
// Keep the original title text; bind the short version label to its preceding term.
const match = title.match(/^(.*?)(\/goal\s*（新）)$/u);
---

<ChineseWords text={match ? match[1] : title} />
{match && (
  <span class="ds-title-tail">
    /goal <small>（新）</small>
  </span>
)}
<style>
  .ds-title-tail {
    white-space: nowrap;
  }
  small {
    font-family: var(--font-sans);
    font-size: max(0.38em, 0.75rem);
    font-weight: 400;
    vertical-align: middle;
    color: var(--muted);
    letter-spacing: 0;
  }
</style>
