---
import { SITE_AUTHOR } from '../consts';

const today = new Date();
---

<footer class="site-footer">
	<div class="footer-inner">
		<span>&copy; {today.getFullYear()} {SITE_AUTHOR}</span>
		<nav aria-label="页脚导航">
			<a href="https://github.com/jellyns" target="_blank" rel="noreferrer">GitHub</a>
			<a href="/rss.xml">RSS</a>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: clamp(4rem, 8vw, 7rem);
		border-top: 1px solid var(--line);
		color: var(--muted);
	}
	.footer-inner {
		width: min(var(--site-width), calc(100% - 2 * var(--page-gutter)));
		min-height: 8.5rem;
		margin-inline: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 0.78rem;
	}
	nav {
		display: flex;
		gap: 1.4rem;
	}
	a {
		color: inherit;
		text-decoration-color: transparent;
	}
	a:hover {
		color: var(--ink);
		text-decoration-color: var(--accent);
	}
	@media (max-width: 40rem) {
		.footer-inner { min-height: 7rem; }
	}
</style>
