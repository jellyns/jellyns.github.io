---
import { SITE_AUTHOR } from "../consts";
---

<footer class="ds-site-footer ds-container">
  <span>
    © {new Date().getFullYear()} {SITE_AUTHOR}
  </span>
  <nav aria-label="页脚导航">
    <a href="https://github.com/jellyns" target="_blank" rel="noreferrer">
      GitHub
    </a>
    <a href="/rss.xml" data-astro-reload>
      RSS
    </a>
  </nav>
</footer>
<style>
  .ds-site-footer {
    border-top: 1px solid var(--line);
    margin-top: 4rem;
    padding-block: 2rem;
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.8rem;
  }
  nav {
    display: flex;
    gap: 1.5rem;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    min-width: 44px;
    justify-content: flex-end;
    color: inherit;
    text-decoration: none;
  }
  a:hover,
  a:focus-visible {
    color: var(--accent);
  }
  @media (max-width: 40rem) {
    .ds-site-footer {
      margin-top: 2.5rem;
      font-size: 0.75rem;
    }
    nav {
      gap: 1rem;
    }
  }
</style>
