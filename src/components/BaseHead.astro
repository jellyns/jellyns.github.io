---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import type { ImageMetadata } from "astro";
import { SITE_TITLE } from "../consts";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#faf9f6" />
<ClientRouter fallback="swap" />
<link
  rel="preload"
  href="/fonts/editorial-song-1.ttf"
  as="font"
  type="font/ttf"
  crossorigin
/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image.src, Astro.url)} />}

<!-- Twitter -->
<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />

<script>
  let navigation = 0;
  type ListVisit = { path: string; scrollY: number; title: string };
  // Keep reading context in this tab only; direct visits retain ordinary links.
  const articleOrigins = new Map<string, ListVisit>();
  let returning: ListVisit | undefined;
  let restoreListScroll = false;
  const isList = (path: string) => path === "/" || path === "/blog/";
  const isArticle = (path: string) => /^\/blog\/[^/]+\/$/.test(path);
  // Match only the title being entered or left, never every title in the index.
  document.addEventListener("astro:before-preparation", (event) => {
    navigation++;
    returning = undefined;
    restoreListScroll = false;
    const entry = event.sourceElement?.closest<HTMLElement>("[data-post-link]");
    entry?.setAttribute("data-opening", "");
    event.signal.addEventListener("abort", () => entry?.removeAttribute("data-opening"), { once: true });
    const origin = isList(event.from.pathname) && isArticle(event.to.pathname)
      ? {
          path: event.from.pathname,
          scrollY: window.scrollY,
          title: entry?.querySelector<HTMLElement>("[data-post-title]")?.dataset.postTitle || "",
        }
      : articleOrigins.get(event.from.pathname);
    const load = event.loader;
    event.loader = async () => {
      try {
        await load();
      } finally {
        entry?.removeAttribute("data-opening");
      }
      if (event.signal.aborted || event.defaultPrevented) return;
      if (isArticle(event.to.pathname) && origin)
        articleOrigins.set(event.to.pathname, origin);
      if (isList(event.to.pathname) && origin?.path === event.to.pathname &&
          (event.navigationType === "traverse" || event.sourceElement?.closest("[data-return-list]"))) {
        returning = origin;
        // Astro restores traversal scroll itself. Only explicit return links need it.
        restoreListScroll = event.navigationType !== "traverse";
      }
      const incoming = event.newDocument;
      // A restored list is already familiar; only its originating entry needs a cue.
      incoming.documentElement.toggleAttribute("data-page-enter", !returning);
      const oldTitles = [
        ...document.querySelectorAll<HTMLElement>("[data-post-title]"),
      ];
      const newTitles = [
        ...incoming.querySelectorAll<HTMLElement>("[data-post-title]"),
      ];
      [...oldTitles, ...newTitles].forEach((title) => {
        title.style.viewTransitionName = "none";
      });
      const articleTitle =
        incoming.querySelector<HTMLElement>("h1[data-post-title]") ||
        document.querySelector<HTMLElement>("h1[data-post-title]");
      const key = articleTitle?.dataset.postTitle;
      if (!key) return;
      const from = oldTitles.find((title) => title.dataset.postTitle === key);
      const to = newTitles.find((title) => title.dataset.postTitle === key);
      if (!from || !to) return;
      const box = from.getBoundingClientRect();
      // A title outside the viewport should not fly into view from off-screen.
      if (box.bottom <= 0 || box.top >= innerHeight) return;
      from.style.viewTransitionName = key;
      to.style.viewTransitionName = key;
    };
  });
  document.addEventListener("astro:before-swap", (event) => {
    const version = navigation;
    event.viewTransition.finished.then(() => {
      if (version !== navigation) return;
      // Page titles must not join unrelated picture-viewer transitions later.
      document
        .querySelectorAll<HTMLElement>("[data-post-title]")
        .forEach((title) => {
          title.style.removeProperty("view-transition-name");
        });
    });
  });
  document.addEventListener("astro:after-swap", () => {
    if (returning && restoreListScroll)
      window.scrollTo({ top: returning.scrollY, behavior: "instant" });
  });
  document.addEventListener("astro:page-load", () => {
    const origin = articleOrigins.get(location.pathname);
    document.querySelectorAll<HTMLAnchorElement>("[data-return-list]").forEach((link) => {
      if (!origin) return;
      link.href = origin.path;
      link.textContent = origin.path === "/" ? "返回首页" : "返回文章列表";
    });
    if (returning) {
      const title = [...document.querySelectorAll<HTMLElement>("[data-post-title]")]
        .find((element) => element.dataset.postTitle === returning!.title);
      const link = title?.closest<HTMLAnchorElement>("[data-post-link]");
      if (link) {
        link.focus({ preventScroll: true });
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          // Descendant entrances also bubble animationend; only the return cue
          // itself may clear this state, including when motion is interrupted.
          const clearCue = (event: AnimationEvent) => {
            if (event.target !== link || event.animationName !== "ds-return-to-entry") return;
            link.removeEventListener("animationend", clearCue);
            link.removeEventListener("animationcancel", clearCue);
            link.removeAttribute("data-returned");
          };
          link.addEventListener("animationend", clearCue);
          link.addEventListener("animationcancel", clearCue);
          link.setAttribute("data-returned", "");
        }
      }
      returning = undefined;
      restoreListScroll = false;
    }
  });
</script>
