---
import type { CollectionEntry } from "astro:content";
import PostEntry from "./PostEntry.astro";
interface Props {
  posts: CollectionEntry<"blog">[];
  featured?: boolean;
  compact?: boolean;
}
const { posts, featured = false, compact = false } = Astro.props;
---

<section
  class:list={["ds-post-collection", { "ds-post-spread": featured }]}
  aria-label="文章目录"
  data-post-collection
>
  {posts.map((post, index) => (
    <PostEntry
      post={post}
      featured={featured && index === 0}
      compact={compact}
      context={featured && index > 0 && posts[0].data.relatedPosts?.some(
        (related) => related.href === `/blog/${post.id}/`,
      ) ? "与上篇相关" : undefined}
    />
  ))}
</section>
<style>
  .ds-post-collection {
    position: relative;
    isolation: isolate;
    min-width: 0;
  }
  .ds-post-spread {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    column-gap: 2.5rem;
  }
  @media (max-width: 60rem) {
    .ds-post-spread {
      grid-template-columns: 1fr;
    }
  }
</style>
