---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import ArticleGallery from "../components/ArticleGallery.astro";
import PostTitle from "../components/PostTitle.astro";
import AuthorRail from "../components/AuthorRail.astro";
import ReadingNav from "../components/ReadingNav.astro";
import { SITE_AUTHOR } from "../consts";
type Props = CollectionEntry<"blog">["data"] & {
  morePosts: {
    title: string;
    href: string;
    description?: string;
    related: boolean;
  }[];
  readingTime: number;
  slug: string;
  headings: { depth: number; slug: string; text: string }[];
};
const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  readingTime,
  gallery,
  slug,
  headings,
  morePosts,
} = Astro.props;
const sections = headings.filter((h) => h.depth === 2);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
  </head>
  <body>
    <Header />
    <main id="main-content" class="ds-container">
      <article
        class:list={[
          "ds-article-layout",
          { "ds-has-edition": Boolean(gallery?.length) },
        ]}
      >
        <header class="ds-article-header">
          <a class="ds-article-back" href="/blog/">
            全部文章
          </a>
          <h1 data-post-title={`post-${slug}`}>
            <PostTitle title={title} />
          </h1>
          <div class="ds-article-meta ds-meta">
            <FormattedDate date={pubDate} />
            <span aria-hidden="true">·</span>
            <span>约 {readingTime} 分钟</span>
            <span class="ds-mobile-byline">{SITE_AUTHOR}</span>
            {updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  更新于 <FormattedDate date={updatedDate} />
                </span>
              </>
            )}
          </div>
        </header>
        <aside class="ds-article-author" aria-label="作者与站点信息">
          <AuthorRail />
        </aside>
        <ReadingNav sections={sections} />
        <div class="ds-article-body">
          {gallery?.length && (
            <details class="ds-edition" id="image-edition">
              <summary>
                阅读图文版{" "}
                <span>
                  {gallery.length} 张图{" "}
                  <span class="ds-edition-sign" aria-hidden="true">
                    ＋
                  </span>
                </span>
              </summary>
              <div class="ds-edition-content">
                <ArticleGallery images={gallery} />
              </div>
            </details>
          )}
          {heroImage && (
            <div class="ds-hero-image">
              <Image width={1120} height={560} src={heroImage} alt="" />
            </div>
          )}
          <div class="ds-prose" id="full-text" tabindex="-1">
            <slot />
          </div>
          <footer class="ds-article-tail" id="article-end">
            {morePosts.length > 0 && (
              <nav class="ds-next-reading" aria-labelledby="next-reading-title">
                <h2 id="next-reading-title">接着读</h2>
                <div class="ds-next-entries">
                  {morePosts.map((post) => {
                    return (
                      <a class="ds-entry-surface" href={post.href}>
                        <span class="ds-meta">
                          {post.related ? "相关版本" : "另一篇文章"}
                        </span>
                        <h3
                          data-post-title={`post-${post.href.split("/").filter(Boolean).at(-1)}`}
                        >
                          <PostTitle title={post.title} />
                        </h3>
                        {post.description && <p>{post.description}</p>}
                      </a>
                    );
                  })}
                </div>
              </nav>
            )}
            <a href="/blog/">返回文章列表</a>
          </footer>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
<script>
  import { onPageLoad } from "../scripts/page-lifecycle";
  onPageLoad((signal) => {
    const edition = document.querySelector<HTMLDetailsElement>(".ds-edition");
    if (edition) {
      edition.addEventListener("toggle", () => {
        if (
          edition.open &&
          !matchMedia("(prefers-reduced-motion: reduce)").matches
        )
          edition.querySelector(".ds-edition-content")?.animate(
            [
              {
                opacity: 0,
                clipPath: "inset(0 0 10% 0)",
                transform: "translateY(-10px)",
              },
              { opacity: 1, clipPath: "inset(0)", transform: "translateY(0)" },
            ],
            { duration: 320, easing: "cubic-bezier(.16,1,.3,1)" },
          );
      });
      function openHash() {
        if (["#image-version", "#image-edition"].includes(location.hash)) {
          edition!.open = true;
          requestAnimationFrame(() =>
            document.querySelector(location.hash)?.scrollIntoView(),
          );
        }
      }
      window.addEventListener("hashchange", openHash, { signal });
      openHash();
    }
  });
</script>
<style>
  .ds-article-layout {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr) minmax(0, var(--reading-width))
      minmax(0, 1fr);
    column-gap: 2.5rem;
    justify-content: center;
    align-items: start;
  }
  .ds-article-body {
    grid-column: 2;
    min-width: 0;
  }
  .ds-article-header {
    grid-column: 2;
    padding: 3rem 0 2.5rem;
  }
  .ds-article-back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    font-size: 0.8rem;
    text-decoration: none;
    margin-bottom: 1.1rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.5;
    letter-spacing: -0.02em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .ds-article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.7rem;
    margin-top: 1.25rem;
  }
  .ds-prose {
    color: var(--prose-ink);
    font-size: 1.125rem;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }
  .ds-prose:focus {
    outline: none;
  }
  :global(.ds-prose p) {
    margin: 0 0 1.4em;
    text-indent: 2em;
  }
  :global(.ds-prose h2) {
    font-size: 1.65rem;
    line-height: 1.6;
    margin: 2.5em 0 0.9em;
    scroll-margin-top: 2rem;
    color: var(--ink);
  }
  :global(.ds-prose h3) {
    font-size: 1.3rem;
    margin: 2em 0 0.75em;
    scroll-margin-top: 2rem;
  }
  :global(.ds-prose li) {
    padding-left: 0.2em;
    margin: 0.45em 0;
  }
  :global(.ds-prose ul),
  :global(.ds-prose ol) {
    padding-left: 1.5em;
    margin: 1.2em 0 1.5em;
  }
  :global(.ds-prose li p),
  :global(.ds-prose blockquote p) {
    text-indent: 0;
  }
  :global(.ds-prose blockquote) {
    margin: 2em 0;
    padding: 1rem 1.35rem;
    border-left: 1px solid var(--accent);
    background: var(--accent-soft);
    color: var(--ink);
    font-size: 1em;
  }
  :global(.ds-prose blockquote p:last-child) {
    margin-bottom: 0;
  }
  :global(.ds-prose pre) {
    max-width: 100%;
    overflow: auto;
    background: var(--code-surface);
    border: 1px solid var(--line);
    padding: 1.2rem;
    margin: 1.5em 0;
    font-size: 0.82rem;
    line-height: 1.8;
    tab-size: 2;
  }
  :global(.ds-prose code) {
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.88em;
  }
  :global(.ds-prose :not(pre) > code) {
    background: var(--code-surface);
    padding: 0.12em 0.3em;
    border-radius: 3px;
    box-decoration-break: clone;
  }
  :global(.ds-prose table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin: 1.8em 0;
  }
  :global(.ds-prose th),
  :global(.ds-prose td) {
    border-bottom: 1px solid var(--line);
    text-align: left;
    padding: 0.75rem 0.85rem;
    min-width: 6rem;
  }
  :global(.ds-prose th) {
    background: var(--code-surface);
    font-weight: 600;
  }
  :global(.ds-prose td code),
  :global(.ds-prose th code) {
    white-space: nowrap;
  }
  :global(.ds-prose img) {
    margin: 2rem auto;
  }
  :global(.ds-prose hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 2.5rem 0;
  }
  .ds-hero-image {
    margin-bottom: 2rem;
  }
  .ds-article-tail {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
  }
  .ds-article-tail > a {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .ds-article-author {
    grid-column: 1;
    grid-row: 1 / span 2;
    position: sticky;
    top: 3rem;
    margin-top: 3rem;
    max-height: calc(100dvh - 6rem);
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .ds-mobile-byline {
    display: none;
  }
  .ds-next-reading {
    margin-bottom: 2rem;
  }
  .ds-next-reading > h2 {
    font-size: 1.25rem;
    margin: 0 0 1rem;
  }
  .ds-next-entries {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }
  .ds-next-entries > a {
    display: block;
    text-decoration: none;
    color: var(--ink);
    padding: 1.25rem 0 1.4rem;
    border-top: 1px solid var(--line);
  }
  .ds-next-entries h3 {
    font-size: 1.2rem;
    line-height: 1.65;
    margin: 0.65rem 0;
    transition: color 180ms var(--ease);
    overflow-wrap: anywhere;
  }
  .ds-next-entries p {
    font-size: 0.8125rem;
    line-height: 1.85;
    color: var(--muted);
    margin: 0;
  }
  .ds-next-entries a:hover h3,
  .ds-next-entries a:focus-visible h3 {
    color: var(--accent-dark);
  }
  .ds-edition {
    margin: 0 0 2rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .ds-edition > summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    list-style: none;
    cursor: pointer;
    font-size: 0.85rem;
    padding: 0.9rem 0;
    color: var(--accent-dark);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .ds-edition > summary > span {
    color: var(--muted);
    font-size: 0.75rem;
  }
  .ds-edition-sign {
    display: inline-block;
    margin-left: 0.6rem;
    transition: transform 200ms var(--ease);
  }
  .ds-edition[open] .ds-edition-sign {
    transform: rotate(45deg);
  }
  .ds-edition-content {
    padding: 1rem 0;
  }
  .ds-edition :global(.ds-gallery) {
    width: 100%;
    margin: 0;
  }
  @media (max-width: 76rem) {
    .ds-article-layout {
      display: flex;
      flex-direction: column;
      width: min(var(--reading-width), 100%);
      margin-inline: auto;
    }
    .ds-article-author {
      display: none;
    }
    .ds-mobile-byline {
      display: inline;
    }
    .ds-article-body,
    .ds-article-header {
      width: 100%;
    }
    .ds-article-header {
      padding-top: 2rem;
    }
    :global(.ds-prose h2),
    :global(.ds-prose h3),
    #full-text {
      scroll-margin-top: 3rem;
    }
    .ds-has-edition :global(.ds-reading-nav:has(details)) {
      margin-bottom: 0;
    }
    .ds-has-edition
      :global(.ds-reading-nav:has(details))
      + .ds-article-body
      .ds-edition {
      border-top: 0;
    }
  }
  @media (max-width: 44rem) {
    .ds-next-entries {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    h1 {
      font-size: 2rem;
      line-height: 1.55;
    }
    .ds-prose {
      font-size: 1.0625rem;
      line-height: 1.9;
    }
    .ds-article-header {
      padding-bottom: 1.7rem;
    }
    .ds-article-back {
      margin-bottom: 1rem;
    }
    .ds-article-meta {
      font-size: 0.75rem;
    }
    :global(.ds-prose h2) {
      font-size: 1.4rem;
      margin-top: 2em;
    }
    :global(.ds-prose pre) {
      padding: 1rem;
      font-size: 0.76rem;
    }
  }
  @media print {
    .ds-article-author,
    .ds-next-reading {
      display: none;
    }
    .ds-article-layout {
      display: block;
      width: 100%;
    }
    .ds-article-header {
      padding: 0;
    }
    .ds-prose {
      font-size: 11pt;
    }
  }
</style>
