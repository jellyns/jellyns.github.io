---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ArticleGallery from '../components/ArticleGallery.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	readingTime: number;
};

const { title, description, pubDate, updatedDate, heroImage, readingTime, gallery, relatedPosts } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		<main id="main-content" class="article-main">
			<article class:list={{ 'article-with-gallery': gallery?.length }}>
				<header class="article-header">
					<a class="article-back" href="/blog/"><span aria-hidden="true">←</span> blog</a>
					<h1>{title}</h1>
					<div class="article-meta">
						<FormattedDate date={pubDate} />
						<span aria-hidden="true">·</span>
						<span>约 {readingTime} 分钟</span>
						{
							updatedDate && (
								<>
									<span aria-hidden="true">·</span>
									<span>更新于 <FormattedDate date={updatedDate} /></span>
								</>
							)
						}
					</div>
				</header>
				{gallery?.length && <ArticleGallery images={gallery} />}

				{
					heroImage && (
						<div class="hero-image">
							<Image width={1120} height={560} src={heroImage} alt="" />
						</div>
					)
				}

				{gallery?.length && (
					<div class="ds-full-text-nav" id="full-text" tabindex="-1">
						<span>全文</span>
						<a href="#image-version">返回图片版 <span aria-hidden="true">↑</span></a>
					</div>
				)}
				<div class="prose">
					<slot />
				</div>

				<footer class="article-tail">
					{relatedPosts?.length && (
						<nav class="ds-related-posts" aria-label="相关版本">
							<span>相关版本</span>
							{relatedPosts.map((post) => <a href={post.href}>{post.title}</a>)}
						</nav>
					)}
					<a href="/blog/"><span aria-hidden="true">←</span> 返回 blog</a>
				</footer>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-main {
		width: 100%;
	}
	.article-header,
	.prose,
	.article-tail {
		width: min(var(--reading-width), calc(100% - 2 * var(--page-gutter)));
		margin-inline: auto;
	}
	.article-header {
		padding-block: clamp(4.5rem, 10vw, 7.5rem) clamp(2.5rem, 6vw, 4rem);
	}
	.article-back {
		display: inline-flex;
		gap: 0.45rem;
		align-items: center;
		margin-bottom: clamp(2.5rem, 6vw, 4rem);
		color: var(--muted);
		font-size: 0.78rem;
		text-decoration: none;
	}
	.article-back:hover { color: var(--accent); }
	.article-header h1 {
		margin: 0;
		font-size: clamp(2.35rem, 6vw, 4.25rem);
		font-weight: 730;
		letter-spacing: -0.04em;
		line-height: 1.16;
		text-wrap: pretty;
		word-break: auto-phrase;
	}
	.article-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.55rem;
		align-items: center;
		margin-top: 1.75rem;
		color: var(--muted);
		font-size: 0.78rem;
	}
	.hero-image {
		width: min(var(--site-width), calc(100% - 2 * var(--page-gutter)));
		margin: 0 auto 4rem;
	}
	.hero-image img {
		width: 100%;
	}
	.prose {
		color: #253c44;
		font-size: 1.075rem;
		line-height: 1.92;
		letter-spacing: 0.005em;
		overflow-wrap: anywhere;
	}
	:global(.prose > p:first-child) {
		margin-top: 0;
		font-size: 1.1em;
		line-height: 1.8;
	}
	:global(.prose p) {
		margin: 0 0 1.55em;
	}
	:global(.prose h2) {
		margin: 3.2em 0 0.9em;
		font-size: 1.7rem;
		letter-spacing: -0.025em;
		line-height: 1.4;
		text-wrap: pretty;
	}
	:global(.prose h3) {
		margin: 2.5em 0 0.8em;
		font-size: 1.28rem;
		letter-spacing: -0.015em;
	}
	:global(.prose h4),
	:global(.prose h5),
	:global(.prose h6) {
		margin: 2.2em 0 0.7em;
		font-size: 1.08rem;
	}
	:global(.prose a) {
		color: var(--accent-dark);
		text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
	}
	:global(.prose a:hover) {
		color: var(--accent);
		text-decoration-color: currentColor;
	}
	:global(.prose ul),
	:global(.prose ol) {
		margin: 0 0 1.6em;
		padding-left: 1.45em;
	}
	:global(.prose li) {
		margin-block: 0.35em;
		padding-left: 0.25em;
	}
	:global(.prose blockquote) {
		margin: 2.25em 0;
		padding: 0.15em 0 0.15em 1.25em;
		border-left: 1px solid var(--accent);
		color: #40575d;
	}
	:global(.prose blockquote p:last-child) { margin-bottom: 0; }
	:global(.prose hr) {
		margin: 3.5rem 0;
		border: 0;
		border-top: 1px solid var(--line);
	}
	:global(.prose code) {
		padding: 0.12em 0.34em;
		border-radius: 0.2rem;
		background: var(--accent-soft);
		font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
		font-size: 0.88em;
	}
	:global(.prose pre) {
		margin: 2rem 0;
		padding: 1.25rem 1.35rem;
		overflow-x: auto;
		border-radius: 0.75rem;
		background: var(--ink);
		color: #edf6f5;
		font-size: 0.88rem;
		line-height: 1.65;
	}
	:global(.prose pre code) {
		padding: 0;
		background: transparent;
		color: inherit;
	}
	:global(.prose table) {
		display: block;
		width: 100%;
		margin: 2rem 0;
		overflow-x: auto;
		border-collapse: collapse;
		font-size: 0.9rem;
	}
	:global(.prose th),
	:global(.prose td) {
		padding: 0.65rem 0.8rem;
		border-bottom: 1px solid var(--line);
		text-align: left;
		white-space: nowrap;
	}
	:global(.prose img) {
		position: relative;
		left: 50%;
		max-width: min(56rem, calc(100vw - 2 * var(--page-gutter)));
		margin: 2.5rem 0;
		transform: translateX(-50%);
	}
	:global(.prose figcaption) {
		margin-top: -1.5rem;
		color: var(--muted);
		font-size: 0.78rem;
		text-align: center;
	}
	.article-tail {
		margin-top: clamp(4rem, 9vw, 7rem);
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
	}
	.article-tail a {
		color: var(--muted);
		font-size: 0.82rem;
		text-decoration: none;
	}
	.article-tail a:hover { color: var(--accent); }
	.article-with-gallery .article-header { padding-block: 1.5rem 1.25rem; }
	.article-with-gallery .article-back { margin-bottom: 0.75rem; }
	.article-with-gallery .article-header h1 { font-size: clamp(1.75rem, 3vw, 2.4rem); line-height: 1.25; }
	.article-with-gallery .article-meta { margin-top: 0.75rem; }
	.ds-full-text-nav {
		width: min(var(--reading-width), calc(100% - 2 * var(--page-gutter)));
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin: 0 auto 1.75rem;
		scroll-margin-top: 1.5rem;
		font-size: 0.78rem;
		color: var(--muted);
	}
	.ds-full-text-nav a { text-decoration: none; }
	.ds-related-posts { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin-bottom: 1.5rem; font-size: 0.82rem; }
	.ds-related-posts span { color: var(--muted); }

	@media (max-width: 44rem) {
		.article-header { padding-block: 3.75rem 2.75rem; }
		.article-back { margin-bottom: 2.5rem; }
		.article-header h1 {
			font-size: clamp(1.95rem, 9vw, 2.55rem);
			line-height: 1.25;
		}
		.article-meta { margin-top: 1.35rem; }
		.hero-image { margin-bottom: 2.75rem; }
		.prose {
			font-size: 1.02rem;
			line-height: 1.88;
		}
		:global(.prose h2) {
			margin-top: 2.8em;
			font-size: 1.48rem;
		}
		:global(.prose h3) { font-size: 1.2rem; }
		:global(.prose img) { margin-block: 2rem; }
	}
</style>
