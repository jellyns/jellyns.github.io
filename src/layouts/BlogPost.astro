---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import ArticleGallery from "../components/ArticleGallery.astro";
import PostTitle from "../components/PostTitle.astro";
import ChineseWords from "../components/ChineseWords.astro";
import ReadingNav from "../components/ReadingNav.astro";
import CodeBlockTools from "../components/CodeBlockTools.astro";
type Props = CollectionEntry<"blog">["data"] & {
  morePosts: {
    title: string;
    href: string;
    description?: string;
    pubDate?: Date;
    related: boolean;
  }[];
  readingTime: number;
  slug: string;
  headings: { depth: number; slug: string; text: string }[];
};
const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  readingTime,
  gallery,
  slug,
  headings,
  morePosts,
} = Astro.props;
const sections = headings.filter((h) => h.depth === 2);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
  </head>
  <body>
    <Header />
    <main id="main-content" class="ds-container">
      <article
        class:list={[
          "ds-article-layout",
          { "ds-has-edition": Boolean(gallery?.length) },
        ]}
      >
        <header class="ds-article-header">
          <h1 data-post-title={`post-${slug}`}>
            <PostTitle title={title} />
          </h1>
        </header>
        <aside class="ds-article-context" aria-label="本文信息">
          <dl class="ds-article-meta ds-meta">
            <div>
              <dt>发布</dt>
              <dd><FormattedDate date={pubDate} /></dd>
            </div>
            <div>
              <dt>阅读</dt>
              <dd>约 {readingTime} 分钟</dd>
            </div>
            {updatedDate && (
              <div class="ds-meta-updated">
                <dt>更新</dt>
                <dd><FormattedDate date={updatedDate} /></dd>
              </div>
            )}
          </dl>
          <a class="ds-article-back" href="/blog/" data-return-list>
            返回文章列表
          </a>
        </aside>
        <ReadingNav sections={sections} />
        <div class="ds-article-body">
          {gallery?.length && (
            <details class="ds-edition" id="image-edition">
              <summary>
                阅读图文版{" "}
                <span>
                  {gallery.length} 张图{" "}
                  <span class="ds-edition-sign" aria-hidden="true">
                    ＋
                  </span>
                </span>
              </summary>
              <div class="ds-edition-content">
                <ArticleGallery images={gallery} />
              </div>
            </details>
          )}
          {heroImage && (
            <div class="ds-hero-image">
              <Image width={1120} height={560} src={heroImage} alt="" />
            </div>
          )}
          <div class="ds-prose" id="full-text" tabindex="-1">
            <slot />
          </div>
          <footer class="ds-article-tail" id="article-end">
            <div class="ds-tail-heading">
              {morePosts.length > 0 && <h2 id="next-reading-title">接着读</h2>}
              <a class="ds-article-back" href="/blog/" data-return-list>返回文章列表</a>
            </div>
            {morePosts.length > 0 && (
              <nav class="ds-next-reading" aria-labelledby="next-reading-title">
                <div class="ds-next-entries">
                  {morePosts.map((post) => {
                    const postKey = post.href.split("/").filter(Boolean).at(-1);
                    const titleId = `next-${postKey}`;
                    return (
                      <a class="ds-entry-surface" href={post.href} aria-labelledby={titleId} data-post-link>
                        <div class="ds-next-meta ds-meta">
                          {post.pubDate && <FormattedDate date={post.pubDate} format="compact" />}
                          {post.related && <span>相关版本</span>}
                        </div>
                        <h3
                          id={titleId}
                          data-post-title={`post-${postKey}`}
                        >
                          <PostTitle title={post.title} />
                        </h3>
                        {post.description && <p><ChineseWords text={post.description} /></p>}
                      </a>
                    );
                  })}
                </div>
              </nav>
            )}
          </footer>
        </div>
      </article>
    </main>
    <Footer />
    <CodeBlockTools />
  </body>
</html>
<script>
  import { onPageLoad } from "../scripts/page-lifecycle";
  onPageLoad((signal) => {
    const edition = document.querySelector<HTMLDetailsElement>(".ds-edition");
    if (edition) {
      edition.addEventListener("toggle", () => {
        if (
          edition.open &&
          !matchMedia("(prefers-reduced-motion: reduce)").matches
        )
          edition.querySelector(".ds-edition-content")?.animate(
            [
              {
                opacity: 0,
                clipPath: "inset(0 0 10% 0)",
                transform: "translateY(-10px)",
              },
              { opacity: 1, clipPath: "inset(0)", transform: "translateY(0)" },
            ],
            { duration: 320, easing: "cubic-bezier(.16,1,.3,1)" },
          );
      });
      function openHash() {
        if (["#image-version", "#image-edition"].includes(location.hash)) {
          edition!.open = true;
          requestAnimationFrame(() =>
            document.querySelector(location.hash)?.scrollIntoView(),
          );
        }
      }
      window.addEventListener("hashchange", openHash, { signal });
      openHash();
    }
  });
</script>
<style>
  .ds-article-layout {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr) minmax(0, var(--reading-width))
      minmax(0, 1fr);
    column-gap: 2.5rem;
    justify-content: center;
    align-items: start;
  }
  .ds-article-body {
    grid-column: 2;
    grid-row: 2;
    min-width: 0;
  }
  .ds-article-header {
    grid-column: 2;
    padding: var(--page-start-space) 0 2.5rem;
  }
  .ds-article-back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    font-size: 0.8rem;
    text-decoration: none;
    margin-top: 1.25rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.35;
    letter-spacing: -0.02em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .ds-article-meta {
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }
  .ds-article-meta dt {
    font-size: 0.75rem;
    margin-bottom: 0.25rem;
  }
  .ds-article-meta dd {
    margin: 0;
    color: var(--ink);
  }
  .ds-prose {
    color: var(--prose-ink);
    font-size: 1.125rem;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }
  .ds-prose:focus {
    outline: none;
  }
  :global(.ds-prose p) {
    margin: 0 0 1em;
    text-indent: 2em;
  }
  :global(.ds-prose h2) {
    font-size: 1.65rem;
    line-height: 1.5;
    margin: 2.25em 0 0.85em;
    scroll-margin-top: 2rem;
    color: var(--ink);
    text-wrap: balance;
  }
  :global(.ds-prose h3) {
    font-size: 1.3rem;
    margin: 2em 0 0.75em;
    scroll-margin-top: 2rem;
    text-wrap: balance;
  }
  :global(.ds-prose li) {
    padding-left: 0.2em;
    margin: 0.45em 0;
  }
  :global(.ds-prose ul),
  :global(.ds-prose ol) {
    padding-left: 1.5em;
    margin: 1.2em 0 1.5em;
  }
  :global(.ds-prose li p),
  :global(.ds-prose blockquote p) {
    text-indent: 0;
  }
  :global(.ds-prose blockquote) {
    margin: 2em 0;
    padding: 1rem 1.35rem;
    border-left: 1px solid var(--accent);
    background: var(--accent-soft);
    color: var(--ink);
    font-size: 1em;
  }
  :global(.ds-prose blockquote p:last-child) {
    margin-bottom: 0;
  }
  :global(.ds-prose pre) {
    --astro-code-background: var(--code-surface);
    --astro-code-foreground: var(--prose-ink);
    --astro-code-token-comment: var(--muted);
    --astro-code-token-keyword: var(--accent-dark);
    --astro-code-token-string: var(--prose-ink);
    --astro-code-token-string-expression: var(--prose-ink);
    --astro-code-token-constant: var(--accent-dark);
    --astro-code-token-parameter: var(--ink);
    --astro-code-token-function: var(--ink);
    --astro-code-token-punctuation: var(--muted);
    --astro-code-token-link: var(--accent-dark);
    max-width: 100%;
    overflow: auto;
    background: var(--code-surface);
    border: 1px solid var(--line);
    padding: 3.25rem 1.25rem 1.25rem;
    margin: 1.75rem 0;
    font-size: 0.9rem;
    line-height: 1.9;
    tab-size: 2;
    scrollbar-width: thin;
  }
  :global(.ds-prose code) {
    font-family: ui-monospace, SFMono-Regular, Consolas, var(--font-sans);
    font-size: 0.88em;
  }
  :global(.ds-prose pre code) {
    font-size: inherit;
  }
  :global(.ds-prose :not(pre) > code) {
    background: var(--code-surface);
    padding: 0.12em 0.3em;
    border-radius: 3px;
    box-decoration-break: clone;
  }
  :global(.ds-prose :is(h2, h3) > code) {
    background: none;
    padding: 0;
  }
  :global(.ds-prose .ds-table-scroll) {
    max-width: 100%;
    overflow-x: auto;
    margin: 1.8em 0;
    scrollbar-width: thin;
  }
  :global(.ds-prose .ds-table-scroll:focus-visible) {
    outline-offset: -2px;
  }
  :global(.ds-prose table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  :global(.ds-prose th),
  :global(.ds-prose td) {
    border-bottom: 1px solid var(--line);
    text-align: left;
    padding: 0.75rem 0.85rem;
    min-width: 6rem;
    vertical-align: top;
  }
  :global(.ds-prose th) {
    background: var(--code-surface);
    font-weight: 600;
  }
  :global(.ds-prose td code),
  :global(.ds-prose th code) {
    white-space: nowrap;
  }
  :global(.ds-prose img) {
    margin: 2rem auto;
  }
  :global(.ds-prose hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 2.5rem 0;
  }
  .ds-hero-image {
    margin-bottom: 2rem;
  }
  .ds-article-tail {
    margin-top: 3rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
  }
  .ds-tail-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .ds-tail-heading h2 {
    margin: 0;
    font: inherit;
    color: var(--muted);
  }
  .ds-tail-heading .ds-article-back {
    margin: 0;
  }
  .ds-article-back:hover,
  .ds-article-back:focus-visible {
    color: var(--accent-dark);
  }
  .ds-article-context {
    grid-column: 1;
    grid-row: 1 / span 2;
    position: sticky;
    top: 3rem;
    margin-top: var(--page-start-space);
    max-height: calc(100dvh - 6rem);
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .ds-next-entries {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }
  .ds-next-entries > a {
    display: block;
    text-decoration: none;
    color: var(--ink);
    padding: 1.25rem 0 1.5rem;
  }
  .ds-next-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: 0.75rem;
  }
  .ds-next-meta > span {
    padding-left: 0.75rem;
    border-left: 1px solid var(--line);
  }
  .ds-next-entries h3 {
    font-size: 1.3rem;
    line-height: 1.5;
    margin: 0.65rem 0;
    transition: color 180ms var(--ease);
    overflow-wrap: anywhere;
  }
  .ds-next-entries p {
    font-size: 0.8125rem;
    line-height: 1.85;
    color: var(--muted);
    margin: 0;
    text-wrap: balance;
  }
  .ds-next-entries a:hover h3,
  .ds-next-entries a:focus-visible h3 {
    color: var(--accent-dark);
  }
  .ds-edition {
    margin: 0 0 2rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .ds-edition > summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    list-style: none;
    cursor: pointer;
    font-size: 0.85rem;
    padding: 0.9rem 0;
    color: var(--accent-dark);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .ds-edition > summary > span {
    color: var(--muted);
    font-size: 0.75rem;
  }
  .ds-edition-sign {
    display: inline-block;
    margin-left: 0.6rem;
    transition: transform 200ms var(--ease);
  }
  .ds-edition[open] .ds-edition-sign {
    transform: rotate(45deg);
  }
  .ds-edition-content {
    padding: 1rem 0;
  }
  .ds-edition :global(.ds-gallery) {
    width: 100%;
    margin: 0;
  }
  @media (max-width: 76rem) {
    .ds-article-layout {
      display: flex;
      flex-direction: column;
      width: min(var(--reading-width), 100%);
      margin-inline: auto;
    }
    .ds-article-context {
      position: static;
      margin: 0;
      max-height: none;
      overflow: visible;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.25rem 1.5rem;
      padding-bottom: 1.5rem;
      width: 100%;
    }
    .ds-article-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
    }
    .ds-article-meta > div {
      display: flex;
      align-items: baseline;
      gap: 0.35rem;
    }
    .ds-article-meta dt {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .ds-article-meta dd {
      color: var(--muted);
    }
    .ds-article-meta .ds-meta-updated dt {
      position: static;
      width: auto;
      height: auto;
      clip-path: none;
      margin: 0;
    }
    .ds-article-back {
      margin: 0;
    }
    .ds-article-body,
    .ds-article-header {
      width: 100%;
    }
    .ds-article-header {
      padding-bottom: 1rem;
    }
    :global(.ds-prose h2),
    :global(.ds-prose h3),
    #full-text {
      scroll-margin-top: 3rem;
    }
    .ds-has-edition :global(.ds-reading-nav:has(details)) {
      margin-bottom: 0;
    }
    .ds-has-edition
      :global(.ds-reading-nav:has(details))
      + .ds-article-body
      .ds-edition {
      border-top: 0;
    }
  }
  @media (max-width: 44rem) {
    .ds-next-entries {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .ds-next-entries > a + a {
      border-top: 1px solid var(--line);
    }
    h1 {
      font-size: 2rem;
      line-height: 1.4;
    }
    .ds-prose {
      font-size: 1.0625rem;
      line-height: 1.9;
    }
    .ds-article-header {
      padding-bottom: 1rem;
    }
    .ds-article-meta {
      font-size: 0.75rem;
    }
    :global(.ds-prose h2) {
      font-size: 1.4rem;
      margin-top: 2em;
    }
    :global(.ds-prose pre) {
      padding: 3.25rem 1rem 1rem;
      font-size: 0.875rem;
    }
  }
  @media print {
    .ds-article-back,
    .ds-article-tail {
      display: none;
    }
    .ds-article-layout {
      display: block;
      width: 100%;
    }
    .ds-article-header {
      padding: 0;
    }
    .ds-article-context {
      position: static;
      margin: 1rem 0;
    }
    .ds-prose {
      font-size: 11pt;
    }
    :global(.ds-prose pre) {
      padding: 1rem;
      white-space: pre-wrap;
    }
  }
</style>
