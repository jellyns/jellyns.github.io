  "narrative": {
    "northStar": "乙辛Zmod31 · blog",
    "overview": "文章标题与摘要构成版面的主要内容，作者身份与站点入口形成可复用的左侧窄栏。宋体标题与无衬线正文形成分工，连续长文保持稳定；导航、目录和图文版承担辅助阅读。\n\n动效表现页面之间的连续性和操作反馈。文章选择使用局部纸色与细线反馈，不在条目之间移动大面积背景；正文不逐段隐藏或飞入。系统要求减少动态时停止非必要动画。",
    "keyCharacteristics": [
      "近白纸面、墨色文字、朱红标记。",
      "宋体标题、无衬线正文、开放版面与细线。",
      "首行缩进、连续长文、按需展开的图文版。",
      "Astro ClientRouter 同文档标题衔接；图片放大使用独立视图过渡。"
    ],
    "rules": [
      {
        "name": "The Accent Rule",
        "body": "强调色用来指示位置与动作，不取代正文的墨色。",
        "section": "colors"
      },
      {
        "name": "The Measure Rule",
        "body": "正文最大宽度 42rem，段后留白与章节间距分别管理，不靠大面积空白分割普通段落。",
        "section": "typography"
      },
      {
        "name": "The Flat Rule",
        "body": "文章条目保持平整，悬停改变局部纸色、标题颜色和顶端细线，不将条目变成抬升卡片。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 用真实文章标题、摘要和日期构建层级。",
      "Do 保留正文阅读尺度、首行缩进及列表和引用的例外。",
      "Do 检查键盘焦点、手机布局、无脚本阅读与减少动态偏好。",
      "Do 让页面动态响应文章选择，保留键盘和减少动态支持。"
    ],
    "donts": [
      "Don't 默认展开图文版挤走正文。",
      "Don't 让动画等待阻挡文章阅读。",
      "Don't 用某篇博文的内容动画代替全站交互设计。",
      "Don't 补造主题名称、文章、统计数字或空栏目。"
